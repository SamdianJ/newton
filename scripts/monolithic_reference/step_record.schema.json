{
  "type": "object",
  "required": [
    "step",
    "time_s",
    "implementation",
    "manifest_sha256",
    "newton_sha",
    "superdex_sha",
    "device",
    "hardware",
    "build_type",
    "warp_or_build_version",
    "thread_count",
    "actual_parameters_json",
    "joint_q",
    "link_xform",
    "soft_com_m",
    "node_positions_m",
    "min_det_f",
    "penetration_m",
    "normal_physical_force_n",
    "tangential_physical_force_n",
    "residual_contribution",
    "physical_world_force_or_wrench",
    "generalized_physical_force",
    "q_sign_projection_error",
    "x_sign_projection_error",
    "nonlinear_iterations",
    "linear_iterations",
    "convergence_status",
    "converged",
    "committed_unconverged",
    "rolled_back",
    "timing_s"
  ],
  "additionalProperties": false,
  "properties": {
    "step": {"type": "integer", "minimum": 0},
    "time_s": {"type": "number", "minimum": 0},
    "implementation": {"enum": ["newton", "superdex"]},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "newton_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "superdex_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "device": {"type": "string", "minLength": 1},
    "hardware": {"type": "string", "minLength": 1},
    "build_type": {"type": "string", "minLength": 1},
    "warp_or_build_version": {"type": "string", "minLength": 1},
    "thread_count": {"type": "integer", "minimum": 0},
    "actual_parameters_json": {"type": "string", "minLength": 1},
    "joint_q": {"type": "array", "items": {"type": "number"}},
    "link_xform": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 7, "maxItems": 7}},
    "soft_com_m": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "node_positions_m": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}},
    "min_det_f": {"type": "number"},
    "penetration_m": {"type": "number", "minimum": 0},
    "normal_physical_force_n": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "tangential_physical_force_n": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "residual_contribution": {
      "type": "object",
      "required": ["q", "x"],
      "additionalProperties": false,
      "properties": {
        "q": {"type": "array", "items": {"type": "number"}},
        "x": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}}
      }
    },
    "physical_world_force_or_wrench": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 6, "maxItems": 6}},
    "generalized_physical_force": {"type": "array", "items": {"type": "number"}},
    "q_sign_projection_error": {"type": "number", "minimum": 0},
    "x_sign_projection_error": {"type": "number", "minimum": 0},
    "nonlinear_iterations": {"type": "integer", "minimum": 0},
    "linear_iterations": {"type": "integer", "minimum": 0},
    "convergence_status": {"type": "string", "minLength": 1},
    "converged": {"type": "boolean"},
    "committed_unconverged": {"type": "boolean"},
    "rolled_back": {"type": "boolean"},
    "timing_s": {
      "type": "object",
      "required": ["assembly", "collision", "linear_solve", "total"],
      "additionalProperties": false,
      "properties": {
        "assembly": {"type": "number", "minimum": 0},
        "collision": {"type": "number", "minimum": 0},
        "linear_solve": {"type": "number", "minimum": 0},
        "total": {"type": "number", "minimum": 0}
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Offline adapter output contract, one JSON object per step; q residual/generalized force units are N*m for revolute and N for prismatic; x residual is N; world wrench is force N followed by torque N*m."
}
